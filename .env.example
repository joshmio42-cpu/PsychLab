# Copy this file to .env.local at the repository root. Fill values privately.
# Only npm start reads .env.local. The scripted demo and tests need no API key.
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct
PSYCHLAB_PORT=8770
NODE_ENV=production
PSYCHLAB_SESSION_CALL_LIMIT=60
PSYCHLAB_PROCESS_CALL_LIMIT=300
# Optional staging paths are deliberately not activated by this example.

